    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "del": "^8.0.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.66.0",
