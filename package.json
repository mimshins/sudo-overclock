  "scripts": {
    "changesets:empty": "changeset add --empty",
    "changesets:create": "changeset add",
    "changesets:apply": "changeset version",
    "changesets:status": "changeset status --since=main",
    "release": "pnpm build && changeset publish --tag latest",
    "test": "tsx --test src/**/*.test.ts",
    "compile": "tsx scripts/compile.ts",
    "author:new": "tsx scripts/author/new.ts",
    "author:preflight": "tsx scripts/author/preflight.ts",
    "author:publish": "tsx scripts/author/publish.ts",
    "prebuild": "pnpm compile",
    "build": "next build",
    "dev": "next dev",
    "format:fmt": "oxfmt --write",
    "format:lint": "oxlint --fix",
    "format": "run-p format:fmt format:lint",
    "check:format": "oxfmt --check",
    "check:lint": "run-p check:lint:oxlint check:format",
    "check:lint:oxlint": "oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
