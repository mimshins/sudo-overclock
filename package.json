    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
