  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.10.0",
    "pnpm": "10.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimshins/sudo-overclock.git"
  },
